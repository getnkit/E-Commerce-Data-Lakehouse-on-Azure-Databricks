{
	"name": "pl_ingest_onprem_files",
	"properties": {
		"activities": [
			{
				"name": "ForEachFile",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "GetFileList",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GetFileList').output.childItems",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "SwitchByFileName",
							"type": "Switch",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"on": {
									"value": "@split(item().name, '_')[0]",
									"type": "Expression"
								},
								"cases": [
									{
										"value": "settlement",
										"activities": [
											{
												"name": "CopyToLandingSettlement",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "DelimitedTextSource",
														"storeSettings": {
															"type": "FileServerReadSettings",
															"recursive": true,
															"enablePartitionDiscovery": false
														},
														"formatSettings": {
															"type": "DelimitedTextReadSettings"
														}
													},
													"sink": {
														"type": "DelimitedTextSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "DelimitedTextWriteSettings",
															"quoteAllText": true,
															"fileExtension": ".txt"
														}
													},
													"enableStaging": false,
													"translator": {
														"value": "@pipeline().parameters.p_mapping_settlement",
														"type": "Expression"
													}
												},
												"inputs": [
													{
														"referenceName": "ds_filesystem_dynamic_csv",
														"type": "DatasetReference",
														"parameters": {
															"p_folder": {
																"value": "@string('')",
																"type": "Expression"
															},
															"p_file": {
																"value": "@item().name",
																"type": "Expression"
															}
														}
													}
												],
												"outputs": [
													{
														"referenceName": "ds_adls_dynamic_csv",
														"type": "DatasetReference",
														"parameters": {
															"p_container": "landing",
															"p_folder": {
																"value": "external_data/settlements/@{formatDateTime(utcnow(), 'yyyy')}/@{formatDateTime(utcnow(), 'MM')}/@{formatDateTime(utcnow(), 'dd')}",
																"type": "Expression"
															},
															"p_file": {
																"value": "@item().name",
																"type": "Expression"
															}
														}
													}
												]
											},
											{
												"name": "DeleteSourceSettlementFile",
												"type": "Delete",
												"dependsOn": [
													{
														"activity": "CopyToLandingSettlement",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"dataset": {
														"referenceName": "ds_filesystem_dynamic_csv",
														"type": "DatasetReference",
														"parameters": {
															"p_folder": {
																"value": "@string('')",
																"type": "Expression"
															},
															"p_file": {
																"value": "@item().name",
																"type": "Expression"
															}
														}
													},
													"enableLogging": false,
													"storeSettings": {
														"type": "AzureBlobStorageReadSettings",
														"recursive": true,
														"enablePartitionDiscovery": false
													}
												}
											}
										]
									},
									{
										"value": "shipment",
										"activities": [
											{
												"name": "CopyToLandingShipment",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "DelimitedTextSource",
														"storeSettings": {
															"type": "FileServerReadSettings",
															"recursive": true,
															"enablePartitionDiscovery": false
														},
														"formatSettings": {
															"type": "DelimitedTextReadSettings"
														}
													},
													"sink": {
														"type": "DelimitedTextSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "DelimitedTextWriteSettings",
															"quoteAllText": true,
															"fileExtension": ".txt"
														}
													},
													"enableStaging": false,
													"translator": {
														"value": "@pipeline().parameters.p_mapping_shipment",
														"type": "Expression"
													}
												},
												"inputs": [
													{
														"referenceName": "ds_filesystem_dynamic_csv",
														"type": "DatasetReference",
														"parameters": {
															"p_folder": {
																"value": "@string('')",
																"type": "Expression"
															},
															"p_file": {
																"value": "@item().name",
																"type": "Expression"
															}
														}
													}
												],
												"outputs": [
													{
														"referenceName": "ds_adls_dynamic_csv",
														"type": "DatasetReference",
														"parameters": {
															"p_container": "landing",
															"p_folder": {
																"value": "external_data/shipments/@{formatDateTime(utcnow(), 'yyyy')}/@{formatDateTime(utcnow(), 'MM')}/@{formatDateTime(utcnow(), 'dd')}",
																"type": "Expression"
															},
															"p_file": {
																"value": "@item().name",
																"type": "Expression"
															}
														}
													}
												]
											},
											{
												"name": "DeleteSourceShipmentFile",
												"type": "Delete",
												"dependsOn": [
													{
														"activity": "CopyToLandingShipment",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"dataset": {
														"referenceName": "ds_filesystem_dynamic_csv",
														"type": "DatasetReference",
														"parameters": {
															"p_folder": {
																"value": "@string('')",
																"type": "Expression"
															},
															"p_file": {
																"value": "@item().name",
																"type": "Expression"
															}
														}
													},
													"enableLogging": false,
													"storeSettings": {
														"type": "AzureBlobStorageReadSettings",
														"recursive": true,
														"enablePartitionDiscovery": false
													}
												}
											}
										]
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "GetFileList",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_filesystem_dynamic_csv",
						"type": "DatasetReference",
						"parameters": {
							"p_folder": {
								"value": "@string('')",
								"type": "Expression"
							},
							"p_file": {
								"value": "@string('')",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"parameters": {
			"p_mapping_settlement": {
				"type": "object",
				"defaultValue": {
					"type": "TabularTranslator",
					"mappings": [
						{
							"source": {
								"name": "TRX_ID",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "settlement_id",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "REF_ORD_NO",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "order_id",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "EXT_PAY_REF",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "payment_ref",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "MDR_PCT",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "fee_rate",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "TXN_STAT_CD",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "settlement_status",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "STL_DT",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "settlement_date",
								"physicalType": "String"
							}
						}
					],
					"typeConversion": true,
					"typeConversionSettings": {
						"allowDataTruncation": true,
						"treatBooleanAsNumber": false
					}
				}
			},
			"p_mapping_shipment": {
				"type": "object",
				"defaultValue": {
					"type": "TabularTranslator",
					"mappings": [
						{
							"source": {
								"name": "SHP_ID",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "shipment_id",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "REF_ORD",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "order_id",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "AWB_NO",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "tracking_number",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "LOG_PROV",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "carrier_name",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "STS_CD",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "shipping_status",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "WT_GM",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "weight_grams",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "PK_DT",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "pickup_date",
								"physicalType": "String"
							}
						}
					],
					"typeConversion": true,
					"typeConversionSettings": {
						"allowDataTruncation": true,
						"treatBooleanAsNumber": false
					}
				}
			}
		},
		"annotations": []
	}
}