{
	"name": "pl_ingest_onprem_files",
	"properties": {
		"activities": [
			{
				"name": "ForEachFile",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.p_file_list",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "CopyFileToBronze",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "FileServerReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings",
										"copyBehavior": "PreserveHierarchy"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"value": "@if(equals(item().map_type, 'SETTLEMENT'), pipeline().parameters.p_mapping_settlement, pipeline().parameters.p_mapping_shipping)",
									"type": "Expression"
								}
							},
							"inputs": [
								{
									"referenceName": "ds_onprem_csv",
									"type": "DatasetReference",
									"parameters": {
										"folder": {
											"value": "@item().source_folder",
											"type": "Expression"
										},
										"file": {
											"value": "@item().file_name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_dynamic_csv",
									"type": "DatasetReference",
									"parameters": {
										"container": "bronze",
										"folder": {
											"value": "@item().target_folder",
											"type": "Expression"
										},
										"file": {
											"value": "@item().file_name",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"p_file_list": {
				"type": "array",
				"defaultValue": [
					{
						"file_name": "settlement_20251230.csv",
						"source_folder": "settlements",
						"target_folder": "settlements/2025/12",
						"map_type": "SETTLEMENT"
					},
					{
						"file_name": "settlement_20260101.csv",
						"source_folder": "settlements",
						"target_folder": "settlements/2026/01",
						"map_type": "SETTLEMENT"
					},
					{
						"file_name": "shipping_20260101.csv",
						"source_folder": "shipping",
						"target_folder": "shipping/2026/01",
						"map_type": "SHIPPING"
					}
				]
			},
			"p_mapping_settlement": {
				"type": "object",
				"defaultValue": {
					"type": "TabularTranslator",
					"mappings": [
						{
							"source": {
								"name": "TRX_ID",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "settlement_id",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "REF_ORD_NO",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "order_id",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "EXT_PAY_REF",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "payment_ref",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "MDR_PCT",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "fee_rate",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "TXN_STAT_CD",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "settlement_status",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "STL_DT",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "settlement_date",
								"physicalType": "String"
							}
						}
					],
					"typeConversion": true,
					"typeConversionSettings": {
						"allowDataTruncation": true,
						"treatBooleanAsNumber": false
					}
				}
			},
			"p_mapping_shipping": {
				"type": "object",
				"defaultValue": {
					"type": "TabularTranslator",
					"mappings": [
						{
							"source": {
								"name": "SHP_ID",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "shipment_id",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "REF_ORD",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "order_id",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "AWB_NO",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "tracking_number",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "LOG_PROV",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "carrier_name",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "STS_CD",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "shipping_status",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "WT_GM",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "weight_grams",
								"physicalType": "String"
							}
						},
						{
							"source": {
								"name": "PK_DT",
								"type": "String",
								"physicalType": "String"
							},
							"sink": {
								"name": "pickup_date",
								"physicalType": "String"
							}
						}
					],
					"typeConversion": true,
					"typeConversionSettings": {
						"allowDataTruncation": true,
						"treatBooleanAsNumber": false
					}
				}
			}
		},
		"annotations": []
	}
}