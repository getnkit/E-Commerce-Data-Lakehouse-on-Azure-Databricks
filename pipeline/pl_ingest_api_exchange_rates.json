{
	"name": "pl_ingest_api_exchange_rates",
	"properties": {
		"activities": [
			{
				"name": "CopyToLandingExchangeRates",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "SetCurrentDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_api_exchange_rates",
						"type": "DatasetReference",
						"parameters": {
							"p_base": {
								"value": "@pipeline().parameters.p_base_currency",
								"type": "Expression"
							},
							"p_symbol": {
								"value": "@pipeline().parameters.p_target_currency",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adls_dynamic_json",
						"type": "DatasetReference",
						"parameters": {
							"p_container": "landing",
							"p_folder": {
								"value": "external_data/exchange_rates/@{formatDateTime(utcnow(), 'yyyy')}/@{formatDateTime(utcnow(), 'MM')}/@{formatDateTime(utcnow(), 'dd')}",
								"type": "Expression"
							},
							"p_file": {
								"value": "@concat('exchange_rates_', variables('v_current_date'), '.json')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "SetCurrentDate",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_current_date",
					"value": {
						"value": "@formatDateTime(utcnow(), 'yyyyMMdd')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"p_base_currency": {
				"type": "string",
				"defaultValue": "USD"
			},
			"p_target_currency": {
				"type": "string",
				"defaultValue": "THB"
			}
		},
		"variables": {
			"v_current_date": {
				"type": "String"
			}
		},
		"annotations": []
	}
}