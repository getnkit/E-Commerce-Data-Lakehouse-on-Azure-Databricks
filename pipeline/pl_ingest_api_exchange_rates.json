{
	"name": "pl_ingest_api_exchange_rates",
	"properties": {
		"activities": [
			{
				"name": "CopyToLandingExchangeRates",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "SetCurrentDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_api_exchange_rates",
						"type": "DatasetReference",
						"parameters": {
							"p_base": {
								"value": "@pipeline().parameters.p_base_currency",
								"type": "Expression"
							},
							"p_symbol": {
								"value": "@pipeline().parameters.p_target_currency",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adls_dynamic_json",
						"type": "DatasetReference",
						"parameters": {
							"p_container": "landing",
							"p_folder": {
								"value": "external_data/exchange_rates/@{formatDateTime(utcnow(), 'yyyy')}/@{formatDateTime(utcnow(), 'MM')}/@{formatDateTime(utcnow(), 'dd')}",
								"type": "Expression"
							},
							"p_file": {
								"value": "@concat('exchange_rates_', variables('v_current_date'), '.json')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "SetCurrentDate",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_current_date",
					"value": {
						"value": "@formatDateTime(utcnow(), 'yyyyMMdd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "SendAlertSuccess",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "CopyToLandingExchangeRates",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": "https://prod-25.southeastasia.logic.azure.com:443/workflows/7dda7d18216d4cf684a0420d343bbbf7/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=peN0K0drJ3phnGDf_ULP3cM6J_IdUIJKVODPnu7yyB4",
					"body": {
						"value": "{\n    \"pipeline_name\": \"@{pipeline().Pipeline}\",\n    \"pipeline_runId\": \"@{pipeline().RunId}\",\n    \"status\": \"Succeeded\",\n    \"message\": \"Job Done!\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "SendAlertFailed",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "CopyToLandingExchangeRates",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": "https://prod-25.southeastasia.logic.azure.com:443/workflows/7dda7d18216d4cf684a0420d343bbbf7/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=peN0K0drJ3phnGDf_ULP3cM6J_IdUIJKVODPnu7yyB4",
					"body": {
						"value": "{\n    \"pipeline_name\": \"@{pipeline().Pipeline}\",\n    \"pipeline_runId\": \"@{pipeline().RunId}\",\n    \"status\": \"Failed\",\n    \"message\": \"@{activity('CopyToLandingExchangeRates').error.message}\"\n}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"p_base_currency": {
				"type": "string",
				"defaultValue": "USD"
			},
			"p_target_currency": {
				"type": "string",
				"defaultValue": "THB"
			}
		},
		"variables": {
			"v_current_date": {
				"type": "String"
			}
		},
		"annotations": []
	}
}