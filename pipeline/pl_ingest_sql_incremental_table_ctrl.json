{
	"name": "pl_ingest_sql_incremental_table_ctrl",
	"properties": {
		"activities": [
			{
				"name": "ForEachIncrementalTable",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.p_table_list",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "CopyToLandingIncremental",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "SetCurrentTimestamp",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "IfWatermarkFileExists",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "SELECT * FROM @{item().schema}.@{item().table} \nWHERE @{item().watermark_column} > '@{if(empty(item().initial_watermark), variables('v_watermark'), item().initial_watermark)}'",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_asql_ecommerce",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_dynamic_parquet",
									"type": "DatasetReference",
									"parameters": {
										"p_container": "landing",
										"p_folder": {
											"value": "operational_data/@{item().table}/@{formatDateTime(utcnow(), 'yyyy')}/@{formatDateTime(utcnow(), 'MM')}/@{formatDateTime(utcnow(), 'dd')}",
											"type": "Expression"
										},
										"p_file": {
											"value": "@concat(item().table, '_', variables('v_current_timestamp'))",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "SetCurrentTimestamp",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_current_timestamp",
								"value": {
									"value": "@utcNow()",
									"type": "Expression"
								}
							}
						},
						{
							"name": "IfHasNewRows",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "CopyToLandingIncremental",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(activity('CopyToLandingIncremental').output.dataRead, 0)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "DeleteEmptyIncrementalFile",
										"type": "Delete",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"dataset": {
												"referenceName": "ds_adls_dynamic_parquet",
												"type": "DatasetReference",
												"parameters": {
													"p_container": "bronze",
													"p_folder": {
														"value": "operational_data/@{item().table}/@{formatDateTime(utcnow(), 'yyyy')}/@{formatDateTime(utcnow(), 'MM')}/@{formatDateTime(utcnow(), 'dd')}",
														"type": "Expression"
													},
													"p_file": {
														"value": "@concat(item().table, '_', variables('v_current_timestamp'))",
														"type": "Expression"
													}
												}
											},
											"enableLogging": false,
											"storeSettings": {
												"type": "AzureBlobStorageReadSettings",
												"recursive": true,
												"enablePartitionDiscovery": false
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "UpdateWatermark",
										"type": "Copy",
										"dependsOn": [
											{
												"activity": "GetMaxWatermark",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "AzureSqlSource",
												"sqlReaderQuery": {
													"value": "SELECT '@{activity('GetMaxWatermark').output.resultSets[0].rows[0].watermark_value}' AS watermark_value",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "JsonSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "JsonWriteSettings"
												}
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "ds_asql_ecommerce",
												"type": "DatasetReference"
											}
										],
										"outputs": [
											{
												"referenceName": "ds_adls_dynamic_json",
												"type": "DatasetReference",
												"parameters": {
													"p_container": "landing",
													"p_folder": {
														"value": "operational_data/@{item().table}",
														"type": "Expression"
													},
													"p_file": "watermark.json"
												}
											}
										]
									},
									{
										"name": "GetMaxWatermark",
										"type": "Script",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"linkedServiceName": {
											"referenceName": "ls_sql_ecommerce_lakehouse",
											"type": "LinkedServiceReference"
										},
										"typeProperties": {
											"scripts": [
												{
													"type": "Query",
													"text": {
														"value": "SELECT MAX(@{item().watermark_column}) as watermark_value FROM @{item().schema}.@{item().table}",
														"type": "Expression"
													}
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
									}
								]
							}
						},
						{
							"name": "GetWatermarkMetadata",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "ds_adls_dynamic_json",
									"type": "DatasetReference",
									"parameters": {
										"p_container": "bronze",
										"p_folder": {
											"value": "@concat(item().table, '/cdc')",
											"type": "Expression"
										},
										"p_file": "cdc.json"
									}
								},
								"fieldList": [
									"exists"
								],
								"storeSettings": {
									"type": "AzureBlobStorageReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							}
						},
						{
							"name": "IfWatermarkFileExists",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "GetWatermarkMetadata",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@activity('GetWatermarkMetadata').output.exists",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "SetDefaultWatermark",
										"type": "SetVariable",
										"dependsOn": [],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "v_watermark",
											"value": "1900-01-01"
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "LookupLastWatermark",
										"type": "Lookup",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "JsonSource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true,
													"enablePartitionDiscovery": false
												},
												"formatSettings": {
													"type": "JsonReadSettings"
												}
											},
											"dataset": {
												"referenceName": "ds_adls_dynamic_json",
												"type": "DatasetReference",
												"parameters": {
													"p_container": "bronze",
													"p_folder": {
														"value": "@concat(item().table, '/cdc')",
														"type": "Expression"
													},
													"p_file": "cdc.json"
												}
											}
										}
									},
									{
										"name": "SetWatermarkFromLookup",
										"type": "SetVariable",
										"dependsOn": [
											{
												"activity": "LookupLastWatermark",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "v_watermark",
											"value": {
												"value": "@activity('LookupLastWatermark').output.firstRow.cdc",
												"type": "Expression"
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "SendAlertSuccess",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "ForEachIncrementalTable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": "https://prod-25.southeastasia.logic.azure.com:443/workflows/7dda7d18216d4cf684a0420d343bbbf7/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=peN0K0drJ3phnGDf_ULP3cM6J_IdUIJKVODPnu7yyB4",
					"body": {
						"value": "{\n    \"pipeline_name\": \"@{pipeline().Pipeline}\",\n    \"pipeline_runId\": \"@{pipeline().RunId}\",\n    \"status\": \"Succeeded\",\n    \"message\": \"Job Done!\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "SendAlertFailed",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "ForEachIncrementalTable",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": "https://prod-25.southeastasia.logic.azure.com:443/workflows/7dda7d18216d4cf684a0420d343bbbf7/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=peN0K0drJ3phnGDf_ULP3cM6J_IdUIJKVODPnu7yyB4",
					"body": {
						"value": "{\n    \"pipeline_name\": \"@{pipeline().Pipeline}\",\n    \"pipeline_runId\": \"@{pipeline().RunId}\",\n    \"status\": \"Failed\",\n    \"message\": \"Please check ADF Monitor for details.\"\n}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"p_table_list": {
				"type": "array",
				"defaultValue": [
					{
						"schema": "dbo",
						"table": "customers",
						"watermark_column": "updated_at",
						"initial_watermark": ""
					},
					{
						"schema": "dbo",
						"table": "merchants",
						"watermark_column": "updated_at",
						"initial_watermark": ""
					},
					{
						"schema": "dbo",
						"table": "products",
						"watermark_column": "updated_at",
						"initial_watermark": ""
					},
					{
						"schema": "dbo",
						"table": "orders",
						"watermark_column": "updated_at",
						"initial_watermark": ""
					},
					{
						"schema": "dbo",
						"table": "order_details",
						"watermark_column": "updated_at",
						"initial_watermark": ""
					}
				]
			}
		},
		"variables": {
			"v_current_timestamp": {
				"type": "String"
			},
			"v_watermark": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-01-25T11:34:22Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}